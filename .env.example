# Web3Forms — free form-to-email for static sites
# 1. Create a key at https://web3forms.com (verify the inbox that should receive leads)
# 2. Paste the access key below
# 3. Restart `npm run dev` / rebuild for production

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Qsell public product catalogue API base URL (deployment origin, without /api/store/products)
# Example: https://shop.example.com
NEXT_PUBLIC_QSELL_API_URL=
